{% from 'patch_row.j2' import patch_row %}
{% set groups = {'available': [], 'review': [], 'none_reported': []} %}
{% set labels = {
  'available': 'Updates available',
  'none_reported': 'No updates reported',
  'unsupported': 'Unsupported package manager',
  'timeout': 'Update check timed out',
  'check_failed': 'Update check failed',
  'unreachable': 'Unreachable',
  'collection_failed': 'Collection failed'
} %}
{% for host in ansible_play_hosts_all | sort %}
  {% set fields = patch_row(host, hostvars[host].patch_check | default({})) | from_json %}
  {% set status = fields[3] %}
  {% set group = status if status in ['available', 'none_reported'] else 'review' %}
  {% set _ = groups[group].append(fields) %}
{% endfor %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>VM patch report</title>
  <style>
    body { margin: 2rem auto; padding: 0 1rem; max-width: 90rem; font: 1rem/1.5 system-ui, sans-serif; color: #172033; background: #f8fafc; }
    h1 { margin-bottom: .25rem; }
    p { margin-top: 0; }
    .summary { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; list-style: none; }
    .summary li { padding: .5rem .75rem; border-radius: .25rem; background: #e7edf4; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; background: white; }
    th, td { text-align: left; padding: .55rem .75rem; border-bottom: 1px solid #cbd5e1; }
    thead { color: white; background: #27374d; }
    .available td, .summary .available { color: #821b26; background: #fde7e9; }
    .review td, .summary .review { color: #70400b; background: #fff2cf; }
    .available td:nth-child(2), .review td:nth-child(2) { font-weight: 700; }
    td:nth-child(4) { font-family: ui-monospace, monospace; }
  </style>
</head>
<body>
  <main>
    <h1>VM patch report</h1>
    <p>Generated {{ now(utc=true, fmt='%Y-%m-%d %H:%M UTC') }}</p>
    <ul class="summary">
      <li><strong>{{ ansible_play_hosts_all | length }}</strong> VMs in report</li>
      <li class="available"><strong>{{ groups.available | length }}</strong> with updates available</li>
      <li class="review"><strong>{{ groups.review | length }}</strong> need review</li>
      <li><strong>{{ groups.none_reported | length }}</strong> with no updates reported</li>
    </ul>
    <p>Update availability reflects the Yum or DNF repository metadata available to each VM.</p>
    <div class="table-wrap">
      <table aria-label="Patch status by VM">
        <thead>
          <tr><th scope="col">Hostname</th><th scope="col">Update status</th><th scope="col">OS release</th><th scope="col">Running kernel</th></tr>
        </thead>
        <tbody>
{% for group in ['available', 'review', 'none_reported'] %}
{% for host, release, kernel, status in groups[group] %}
          <tr class="{{ group }}">
            <td>{{ host | e }}</td>
            <td>{{ labels.get(status, status) | e }}</td>
            <td>{{ release | default('—', true) | e }}</td>
            <td>{{ kernel | default('—', true) | e }}</td>
          </tr>
{% endfor %}
{% endfor %}
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
